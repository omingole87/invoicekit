{
  "name": "invoicekit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "InvoiceKit — Shared component library and universal invoice renderer engine",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@invoicekit/docs run dev",
    "build": "npm --workspace=@invoicekit/docs run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "jspdf": "^2.5.2"
  }
}
