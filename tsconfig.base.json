{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@invoicekit/tokens": ["packages/tokens/src/index.ts"],
      "@invoicekit/ui": ["packages/ui/src/index.ts"],
      "@invoicekit/renderer": ["packages/renderer/src/index.ts"]
    }
  }
}
